# Środowisko LLM (OpenAI-compatible)
# Domyślnie Google Gemini — darmowy klucz na https://aistudio.google.com/
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# Ścieżka do audit logu
AUDIT_LOG_PATH=/app/audit.log

# Ścieżka do Unix socket (dla Telegram bota na tym samym serwerze)
AGENT_SOCKET=/tmp/vps-agent.sock

# TCP dla SSH tunnel z laptopa (TYLKO 127.0.0.1 — nie eksponuj na zewrątrz!)
TCP_HOST=127.0.0.1
TCP_PORT=7379
