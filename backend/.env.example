# ─── Provider LLM ───────────────────────────────────────────────────────────
# Najprościej: uruchom kreator z katalogu głównego repozytorium. Wybierze
# providera, pobierze aktualną listę modeli, przetestuje tool calling
# i zapisze ten plik za Ciebie:
#
#     python3 -m backend.configure
#
# Wbudowani providerzy (wartość LLM_PROVIDER):
#   gemini (darmowy tier), openai, anthropic, openrouter, groq, deepseek,
#   mistral, xai, zai, kimi, together, cerebras, fireworks, ollama
# Opisy i adresy: python3 -m backend.configure --providers
LLM_PROVIDER=gemini

# Klucz API wybranego providera. Zamiast niego możesz ustawić zmienną
# specyficzną dla providera, np. GEMINI_API_KEY albo OPENAI_API_KEY.
LLM_API_KEY=

# Pusty = domyślny model providera. Aktualne modele: python3 -m backend.configure --models
LLM_MODEL=

# Własny endpoint zgodny z OpenAI — nadpisuje adres z presetu providera:
# LLM_BASE_URL=https://moj-serwer.example.com/v1

# Opcjonalnie: poziom rozumowania dla modeli, które go obsługują (np. low, medium, high)
# LLM_REASONING_EFFORT=
# Opcjonalnie: limit czasu odpowiedzi LLM w sekundach (domyślnie 120)
# LLM_TIMEOUT=120

# Token autoryzacji — klienci muszą go przesyłać (CLI: --token, bot: AGENT_TOKEN w jego .env).
# Kreator i scripts/install-server.sh generują go automatycznie, gdy jest pusty.
# W trybie kubernetes jest wymagany (port osiągalny z każdego poda). Pusty = ochrona
# tylko przez tunel SSH / uprawnienia socketu — nie zostawiaj pustego na współdzielonym hoście.
AGENT_TOKEN=

# Ścieżka do audit logu
AUDIT_LOG_PATH=/app/audit.log

# Ścieżka do Unix socket (dla Telegram bota na tym samym serwerze)
AGENT_SOCKET=/tmp/vps-agent.sock

# TCP dla SSH tunnel z laptopa. W kontenerze 0.0.0.0 — na hoscie port jest
# publikowany tylko na 127.0.0.1 (docker-compose.yml). Natywnie ustaw 127.0.0.1.
TCP_HOST=127.0.0.1
TCP_PORT=7379

# ─── Jezyk / Language ───────────────────────────────────────────────────────
# pl (domyslnie) | en — jezyk agenta: prompty, komunikaty, alerty, raporty, wbudowane skille.
# pl (default) | en — the agent's language: prompts, messages, alerts, reports, built-in skills.
# Bot Telegrama i CLI maja ten sam przelacznik (clients/telegram/.env, `pipe --lang en`).
# PIPE_LANG=pl

# ─── Strefa czasowa ─────────────────────────────────────────────────────────
# W Dockerze kontenery biora strefe z hosta (/etc/localtime). Jesli serwer chodzi w UTC, a Ty chcesz,
# zeby "przypomnij o 9", poranny raport (DIGEST_TIME) i rutyny liczyly sie w Twoim czasie — ustaw strefe:
# TZ=Europe/Warsaw

# ─── Tryb dzialania ─────────────────────────────────────────────────────────
# auto (domyslnie) | docker | native | kubernetes — patrz docs/deploy.md
# PIPE_RUNTIME=auto
# Nadpisanie sciezek hosta (zwykle niepotrzebne):
# HOST_ROOT=/hostfs
# HOST_PROC=/hostproc

# ─── Workery i petla agenta ─────────────────────────────────────────────────
# Model dla workerow (pod-agentow) i nauki stylu — pusty = ten sam co LLM_MODEL.
# Tanszy model = tansze rownolegle badanie wielu serwerow.
# WORKER_MODEL=
# WORKER_TIMEOUT=240
# MAX_WORKERS=6
# AGENT_MAX_ITERATIONS=15
# Limit czasu (s) dla komend zatwierdzonych przez uzytkownika (aktualizacje, buildy)
# CONFIRMED_COMMAND_TIMEOUT=900
# Ukrywanie sekretow (klucze, hasla) w wynikach narzedzi przed wyslaniem do LLM
# REDACT_SECRETS=1

# ─── Czuwanie (proaktywne alerty) ───────────────────────────────────────────
# WATCH_ENABLED=1
# WATCH_INTERVAL=120
# WATCH_DISK_PCT=90
# WATCH_MEM_PCT=92
# WATCH_LOAD_FACTOR=2
# Historia pomiarow do wykresow (dni)
# METRICS_KEEP_DAYS=8
# Migawki stanu hosta ("co sie zmienilo"): co ile sekund i jak dlugo trzymac (dni)
# SNAPSHOT_INTERVAL=3600
# SNAPSHOT_KEEP_DAYS=30
# Certyfikaty, strony i DNS domen z konfiguracji proxy + swiezosc backupow z DIRECTORY
# CHECKS_INTERVAL=3600
# WATCH_SITES=1
# WATCH_CERT_DAYS=14
# WATCH_BACKUP_HOURS=26
# Log SSH: alert przy tylu nieudanych logowaniach w 10 min (0 = wylaczone) i przy logowaniu z nowego adresu
# WATCH_SSH_FAILURES=60
# WATCH_SSH_LOGINS=1
# WATCH_IGNORE=staging.example.com,/var/backups/archiwum
# Poranny raport (czas serwera); off = wylaczony
# DIGEST_TIME=07:00

# ─── Bezpiecznik ────────────────────────────────────────────────────────────
# Nieudana weryfikacja zmiany konfiguracji (nginx -t, sshd -t, JSON...) -> przywroc kopie automatycznie
# SAFE_AUTO_ROLLBACK=1

# ─── Role ────────────────────────────────────────────────────────────────────
# Token tylko do odczytu (np. dla TELEGRAM_VIEWER_IDS); wymaga AGENT_TOKEN. Tokeny per osoba/laptop:
#   python3 -m backend.tokens add laptop-kuba --role admin|viewer
# AGENT_VIEWER_TOKEN=

# ─── Webhooki: alerty z Alertmanagera, Grafany, Uptime Kuma, GitHuba ────────
# WEBHOOK_PORT=7380
# WEBHOOK_TOKEN=          # wymagany: openssl rand -hex 24
# WEBHOOK_INVESTIGATE=1   # nowy alert od razu bada worker (tylko odczyty)

# ─── MCP: Pipe jako serwer dla innych agentow (Claude Code, Cursor...) ──────
# Most stdio z laptopa dziala bez tego: pipe --mcp --host root@serwer. Endpoint HTTP (tylko localhost):
# MCP_PORT=7381
# MCP_ALLOWED_ORIGINS=
# Serwery MCP, z ktorych korzysta Pipe: backend/data/mcp.json (dodawanie: "dodaj serwer MCP ...")

# ─── Wiadomosci glosowe (Telegram) ──────────────────────────────────────────
# Przy LLM_PROVIDER=openai albo groq dziala samo. Inaczej, np. darmowy Groq:
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=pl

# ─── Koszty LLM ─────────────────────────────────────────────────────────────
# Ceny w USD za milion tokenow — /koszt pokaze koszt, nie tylko tokeny
# LLM_PRICE_IN=0.30
# LLM_PRICE_OUT=2.50
# WORKER_PRICE_IN=
# WORKER_PRICE_OUT=
# Dzienny limit (0 = bez limitu); po przekroczeniu agent czeka do polnocy, czuwanie dziala dalej
# DAILY_TOKEN_LIMIT=0
# DAILY_COST_LIMIT=0

# ─── VIBE ───────────────────────────────────────────────────────────────────
# Co ile wiadomosci agent odswieza notatke o stylu uzytkownika (0 = wylaczone)
# VIBE_EVERY=6
