TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
AGENT_SOCKET=/tmp/vps-agent.sock

# Must match AGENT_TOKEN in backend/.env (empty = no token required)
AGENT_TOKEN=

# 0 = don't forward watch alerts and routine reports
TELEGRAM_ALERTS=1

# Read-only (chat, diagnosis, reports, alerts; no approving changes and no /undo).
# Needs AGENT_VIEWER_TOKEN, the same as in backend/.env.
TELEGRAM_VIEWER_IDS=
AGENT_VIEWER_TOKEN=

# Bot language: en (default) | pl, set it like PIPE_LANG in backend/.env.
# scripts/install-server.sh copies this value from backend/.env.
# PIPE_LANG=en
