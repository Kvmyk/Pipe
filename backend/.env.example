# ─── LLM provider ───────────────────────────────────────────────────────────
# The easiest way: run the wizard from the repository root. It picks the
# provider, fetches the current model list, tests tool calling
# and writes this file for you:
#
#     python3 -m backend.configure
#
# Built-in providers (the LLM_PROVIDER value):
#   gemini (free tier), openai, anthropic, openrouter, groq, deepseek,
#   mistral, xai, zai, kimi, together, cerebras, fireworks, ollama
#   none = no model: watching, reports, audit and the MCP gateway, chat after adding a provider
# Descriptions and addresses: python3 -m backend.configure --providers
LLM_PROVIDER=gemini

# API key of the chosen provider. Instead of it you can set the provider's own
# variable, e.g. GEMINI_API_KEY or OPENAI_API_KEY.
# Keys of more providers (e.g. OPENAI_API_KEY, GROQ_API_KEY) can be added here or
# in `pipe web` (/providers): the switcher in the chat shows every provider that has a key.
LLM_API_KEY=

# Empty = the provider's default model. Current models: python3 -m backend.configure --models
LLM_MODEL=

# Your own OpenAI-compatible endpoint; overrides the address from the provider preset:
# LLM_BASE_URL=https://my-server.example.com/v1

# Optional: reasoning effort for models that support it (e.g. low, medium, high)
# LLM_REASONING_EFFORT=
# Optional: LLM response timeout in seconds (default 120)
# LLM_TIMEOUT=120

# Authorization token: clients must send it (CLI: --token, bot: AGENT_TOKEN in its .env).
# The wizard and scripts/install-server.sh generate it when it is empty.
# Required in kubernetes mode (the port is reachable from every pod). Empty = protection
# only by the SSH tunnel / socket permissions; don't leave it empty on a shared host.
AGENT_TOKEN=

# Audit log path
AUDIT_LOG_PATH=/app/audit.log

# Unix socket path (for the Telegram bot on the same server)
AGENT_SOCKET=/tmp/vps-agent.sock

# TCP for the SSH tunnel from your laptop. 0.0.0.0 inside the container; on the host the port is
# published only on 127.0.0.1 (docker-compose.yml). Natively set 127.0.0.1.
TCP_HOST=127.0.0.1
TCP_PORT=7379

# ─── Language ───────────────────────────────────────────────────────────────
# en (default) | pl: the agent's language: prompts, messages, alerts, reports, built-in skills.
# The Telegram bot and the CLI use the same switch (clients/telegram/.env, `pipe --lang pl`).
# PIPE_LANG=en

# ─── Time zone ──────────────────────────────────────────────────────────────
# In Docker the containers take the host's time zone (/etc/localtime). If the server runs in UTC and you want
# "remind me at 9", the morning report (DIGEST_TIME) and routines to count in your time, set the zone:
# TZ=Europe/London

# ─── Runtime mode ───────────────────────────────────────────────────────────
# auto (default) | docker | native | kubernetes, see docs/deploy.md
# PIPE_RUNTIME=auto
# Override the host paths (usually not needed):
# HOST_ROOT=/hostfs
# HOST_PROC=/hostproc
# Observe mode: Pipe reads and watches but changes nothing on the server (state-changing commands, file writes,
# /undo and MCP approvals are refused). The installer sets it with --profile observe and in Docker adds
# docker-compose.observe.yml (no writes to docker.sock, /root read-only).
# PIPE_OBSERVE=0

# ─── Workers and the agent loop ─────────────────────────────────────────────
# Model for workers (sub-agents) and style learning; empty = the same as LLM_MODEL.
# A cheaper model = cheaper parallel investigation of many servers.
# WORKER_MODEL=
# WORKER_TIMEOUT=240
# MAX_WORKERS=6
# AGENT_MAX_ITERATIONS=15
# Saving tokens: lazy = tools loaded on demand, all = all of them always
# TOOLS_MODE=lazy
# Tool results older than this many turns go to the model shortened (0 = always in full)
# CONTEXT_KEEP_TURNS=2
# Conversations survive a backend restart (DATA_DIR/sessions, 0600) for this many days; 0 = not saved
# SESSION_KEEP_DAYS=7
# Internet for the agent (web_search / web_fetch), no API key:
# on = DuckDuckGo, and when it doesn't answer, Wikipedia; off = no internet
# WEB_SEARCH=on
# Timeout (s) for commands approved by the user (updates, builds)
# CONFIRMED_COMMAND_TIMEOUT=900
# Hide secrets (keys, passwords) in tool results before they are sent to the LLM
# REDACT_SECRETS=1

# ─── Watching (proactive alerts) ────────────────────────────────────────────
# WATCH_ENABLED=1
# WATCH_INTERVAL=120
# WATCH_DISK_PCT=90
# WATCH_MEM_PCT=92
# WATCH_LOAD_FACTOR=2
# Measurement history for charts (days)
# METRICS_KEEP_DAYS=8
# Host state snapshots ("what changed"): every how many seconds and how long to keep them (days)
# SNAPSHOT_INTERVAL=3600
# SNAPSHOT_KEEP_DAYS=30
# Certificates, sites and DNS of domains from the proxy config + backup freshness from DIRECTORY
# CHECKS_INTERVAL=3600
# WATCH_SITES=1
# WATCH_CERT_DAYS=14
# WATCH_BACKUP_HOURS=26
# Package vulnerabilities (OSV.dev, sends package names and versions): a scan on package change and every this many seconds; 0 = off
# VULN_INTERVAL=21600
# SSH log: an alert at this many failed logins in 10 min (0 = off) and on a login from a new address
# WATCH_SSH_FAILURES=60
# WATCH_SSH_LOGINS=1
# WATCH_IGNORE=staging.example.com,/var/backups/archive
# Morning report (server time); off = disabled
# DIGEST_TIME=07:00

# ─── Pipe writes first: inbox, suggestions, self-started investigations ─────
# When to notify: all | important (default) | critical. You can also change it while working: /notifications
# NOTIFY_LEVEL=important
# Quiet hours: at night only critical matters, the rest in the morning (empty = off)
# QUIET_HOURS=22:00-07:00
# Suggestions without AI (disk forecast, space to reclaim, restarts...): every how many seconds (0 = off)
# and at most how many a day with a notification
# INSIGHTS_INTERVAL=3600
# INSIGHTS_PER_DAY=3
# Pipe investigates a critical alert itself (worker, reads only): critical | all | off; at most this many a day
# AUTO_INVESTIGATE=critical
# AUTO_INVESTIGATE_DAILY=4

# ─── Workshop: projects Pipe clones and runs ────────────────────────────────
# Host directory for projects; file writes and commands in an isolated container without asking (0 = ask about everything)
# WORKSPACE_DIR=/root/pipe-workspace
# WORKSPACE_AUTONOMY=1
# Project container limits, command and build time (s), the largest clone (MB)
# PROJECT_MEMORY=1g
# PROJECT_CPUS=1
# PROJECT_EXEC_TIMEOUT=600
# PROJECT_BUILD_TIMEOUT=1800
# PROJECT_MAX_MB=1024

# ─── Safety fuse ────────────────────────────────────────────────────────────
# A failed check after a config change (nginx -t, sshd -t, JSON...) -> restore the backup automatically
# SAFE_AUTO_ROLLBACK=1
# Autonomy: Pipe makes routine changes (restart, reload, a config edit with a backup, packages from the repository)
# without asking; it asks about deleting data, access, autostart and unknown commands. 0 = ask about every change.
# AUTONOMY=1

# ─── Roles ──────────────────────────────────────────────────────────────────
# Read-only token (e.g. for TELEGRAM_VIEWER_IDS); needs AGENT_TOKEN. Tokens per person/laptop:
#   python3 -m backend.tokens add my-laptop --role admin|viewer
# AGENT_VIEWER_TOKEN=

# ─── Webhooks: alerts from Alertmanager, Grafana, Uptime Kuma, GitHub ───────
# WEBHOOK_PORT=7380
# WEBHOOK_TOKEN=          # required: openssl rand -hex 24
# WEBHOOK_INVESTIGATE=1   # a worker investigates a new alert at once (reads only)

# ─── MCP: Pipe as a server for other agents (Claude Code, Cursor...) ────────
# The stdio bridge from your laptop works without this: pipe --mcp --host root@server. HTTP endpoint (localhost only):
# MCP_PORT=7381
# MCP_ALLOWED_ORIGINS=
# MCP servers Pipe uses: /mcp add ... or "connect the MCP server ..." (backend/data/mcp_servers.json).
# Their secrets go here, prefixed with MCP_, and in the server config as ${MCP_NAME}, never in the chat, e.g.:
# MCP_GITHUB_TOKEN=

# ─── Voice messages (Telegram, pipe web) ────────────────────────────────────
# With LLM_PROVIDER=gemini (the model itself), openai or groq (Whisper) it works by itself. Otherwise, e.g. free Groq:
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=en

# ─── LLM costs ──────────────────────────────────────────────────────────────
# Prices in USD per million tokens, so /cost shows the cost, not just tokens
# LLM_PRICE_IN=0.30
# LLM_PRICE_OUT=2.50
# WORKER_PRICE_IN=
# WORKER_PRICE_OUT=
# Daily limit (0 = no limit); when exceeded the agent waits until midnight, watching keeps working
# DAILY_TOKEN_LIMIT=0
# DAILY_COST_LIMIT=0

# ─── VIBE ───────────────────────────────────────────────────────────────────
# Every how many messages the agent refreshes its note about the user's style (0 = off)
# VIBE_EVERY=6
