TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
AGENT_SOCKET=/tmp/vps-agent.sock

# Musi byc zgodny z AGENT_TOKEN w backend/.env (pusty = brak wymogu tokenu)
AGENT_TOKEN=

# 0 = nie przesylaj alertow czuwania i raportow rutyn
TELEGRAM_ALERTS=1

# Tylko odczyt (rozmowa, diagnoza, raporty, alerty — bez zatwierdzania zmian i /cofnij).
# Wymaga AGENT_VIEWER_TOKEN — tego samego co w backend/.env.
TELEGRAM_VIEWER_IDS=
AGENT_VIEWER_TOKEN=
